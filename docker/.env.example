# Copy to docker/.env (Compose reads it relative to the compose file).
#   cp docker/.env.example docker/.env
TZ=Asia/Shanghai
OFM_REFRESH=1

# Upstream source used at image build time. Change the ref to deploy another
# tag/commit; rebuild with `sh install.sh`.
OFM_SOURCE_REPO=https://github.com/Ebony-Vinyl/dsh-our-free-model.git
OFM_SOURCE_REF=v2.7.2

# Which host interface publishes 8080/18901. Use a specific LAN IP to avoid
# exposing the ports on every interface, e.g. OFM_BIND_IP=192.168.1.10.
OFM_BIND_IP=0.0.0.0

# Web UI login token (managementKey). Generate with:
#   openssl rand -base64 32
OFM_MANAGEMENT_KEY=

# API bearer token (LAN relay key). Generate another independent value:
#   openssl rand -base64 32
OFM_LAN_KEY=

# Optional extra HTTP Basic Auth in front of the Web UI (user:password).
# OFM_UI_BASIC_AUTH=admin:change-me

# For Docker secrets instead of env, mount files and use:
# OFM_MANAGEMENT_KEY_FILE=/run/secrets/ofm_management_key
# OFM_LAN_KEY_FILE=/run/secrets/ofm_lan_key
